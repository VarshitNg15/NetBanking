# ==============================================================================
# NetBanking API Gateway - Environment Variables Template
# ==============================================================================
# Copy this file to .env and configure your secret credentials.
# NEVER commit the actual .env file with secrets into version control!

# Server Port
SERVER_PORT=8080

# Redis Cache & Rate Limiting Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Pure JWT Secret Configuration (HMAC-SHA256 256-bit Base64 Key)
# Must match the JWT_SECRET configured in auth-service
JWT_SECRET=your-256-bit-secret-here-base64-encoded

# Eureka Service Discovery URL
EUREKA_URI=http://localhost:8761/eureka/
