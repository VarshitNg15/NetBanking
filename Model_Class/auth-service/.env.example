# ==============================================================================
# NetBanking Auth Service - Environment Variables Template
# Copy this file to .env and provide your secret values.
# ==============================================================================

# Server Port
SERVER_PORT=8081

# Oracle Database Credentials
AUTH_DB_URL=jdbc:oracle:thin:@localhost:1521/FREEPDB1
AUTH_DB_USERNAME=AUTH_SCHEMA
AUTH_DB_PASSWORD=your_secure_db_password

# Pure JWT Secret Configuration (Must be at least 256 bits, Base64-encoded)
JWT_SECRET=your_base64_encoded_256_bit_secret_key_here
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000
JWT_ISSUER=netbanking-auth-service

# Inter-Service Feign Clients
USER_SERVICE_URL=http://localhost:8082

# Eureka Service Discovery
EUREKA_URI=http://localhost:8761/eureka/

# Apache Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
AUTH_KAFKA_TOPIC=auth-events

# Background Token Cleanup Interval (ms)
AUTH_CLEANUP_DELAY_MS=3600000
