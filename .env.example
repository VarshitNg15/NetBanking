# ==============================================================================
# NetBanking Microservices Architecture - Master Environment Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API GATEWAY & EDGE SECURITY (Port 8080)
# ------------------------------------------------------------------------------
SERVER_PORT=8080
GATEWAY_PORT=8080
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Pure JWT Configuration (HMAC-SHA256 256-bit Key)
JWT_SECRET=your_base64_encoded_256_bit_secret_key_here
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000
JWT_ISSUER=netbanking-auth-service

# ------------------------------------------------------------------------------
# 2. INFRASTRUCTURE & DISCOVERY SERVICES
# ------------------------------------------------------------------------------
EUREKA_SERVER_PORT=8761
EUREKA_URI=http://localhost:8761/eureka/
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION SERVICE (Port 8081)
# ------------------------------------------------------------------------------
AUTH_SERVER_PORT=8081
AUTH_DB_URL=jdbc:oracle:thin:@localhost:1521/FREEPDB1
AUTH_DB_USERNAME=AUTH_SCHEMA
AUTH_DB_PASSWORD=your_auth_schema_password
AUTH_KAFKA_TOPIC=auth-events
AUTH_CLEANUP_DELAY_MS=3600000

# ------------------------------------------------------------------------------
# 4. USER & CUSTOMER PROFILE SERVICE (Port 8082)
# ------------------------------------------------------------------------------
USER_SERVER_PORT=8082
USER_DB_URL=jdbc:oracle:thin:@localhost:1521/FREEPDB1
USER_DB_USERNAME=USER_SCHEMA
USER_DB_PASSWORD=your_user_schema_password
USER_KAFKA_GROUP_ID=user-service-group

# ------------------------------------------------------------------------------
# 5. ACCOUNT & LEDGER SERVICE (Port 8083)
# ------------------------------------------------------------------------------
ACCOUNT_SERVER_PORT=8083
ACCOUNT_DB_URL=jdbc:oracle:thin:@localhost:1521/FREEPDB1
ACCOUNT_DB_USERNAME=ACCOUNT_SCHEMA
ACCOUNT_DB_PASSWORD=your_account_schema_password

# ------------------------------------------------------------------------------
# 6. TRANSACTION & TRANSFER SERVICE (Port 8084)
# ------------------------------------------------------------------------------
TRANSACTION_SERVER_PORT=8084
TRANSACTION_DB_URL=jdbc:oracle:thin:@localhost:1521/FREEPDB1
TRANSACTION_DB_USERNAME=TRANSACTION_SCHEMA
TRANSACTION_DB_PASSWORD=your_transaction_schema_password
TRANSACTION_KAFKA_TOPIC=transaction-events

# ------------------------------------------------------------------------------
# 7. NOTIFICATION & AUDIT SERVICE (Port 8085)
# ------------------------------------------------------------------------------
NOTIFICATION_SERVER_PORT=8085
NOTIFICATION_DB_URL=jdbc:oracle:thin:@localhost:1521/FREEPDB1
NOTIFICATION_DB_USERNAME=NOTIFICATION_SCHEMA
NOTIFICATION_DB_PASSWORD=your_notification_schema_password
NOTIFICATION_KAFKA_GROUP_ID=notification-service-group
NOTIFICATION_KAFKA_TOPIC=notification-events
AUDIT_KAFKA_TOPIC=audit-events

# SMTP Email Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_smtp_email@gmail.com
MAIL_PASSWORD=your_smtp_app_password
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true

# ------------------------------------------------------------------------------
# 8. INTER-SERVICE OPENFEIGN URLs (Fallback direct URLs)
# ------------------------------------------------------------------------------
USER_SERVICE_URL=http://localhost:8082
ACCOUNT_SERVICE_URL=http://localhost:8083
TRANSACTION_SERVICE_URL=http://localhost:8084
NOTIFICATION_SERVICE_URL=http://localhost:8085
