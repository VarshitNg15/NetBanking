# ==============================================================================
# NetBanking Microservices Architecture - Master Environment Configuration Template
# ==============================================================================
# Copy this file to .env and supply environment-specific credentials.
# NEVER commit the actual .env file with secrets into version control!

# ------------------------------------------------------------------------------
# 1. API Gateway Configuration
# ------------------------------------------------------------------------------
GATEWAY_PORT=8080
REDIS_HOST=localhost
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 2. Pure JWT Security Configuration (HMAC-SHA256 256-bit Key)
# ------------------------------------------------------------------------------
# Shared between auth-service (token issuer) and api-gateway (edge validator)
JWT_SECRET=your-256-bit-secret-here-base64-encoded
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000
JWT_ISSUER=netbanking-auth-service

# ------------------------------------------------------------------------------
# 3. Auth Service Configuration & Database Secrets
# ------------------------------------------------------------------------------
AUTH_SERVER_PORT=8081
AUTH_DB_URL=jdbc:oracle:thin:@localhost:1521/FREEPDB1
AUTH_DB_USERNAME=AUTH_SCHEMA
AUTH_DB_PASSWORD=your_auth_db_password
AUTH_KAFKA_TOPIC=auth-events
AUTH_CLEANUP_DELAY_MS=3600000

# ------------------------------------------------------------------------------
# 4. User Service Configuration & Database Secrets
# ------------------------------------------------------------------------------
USER_SERVER_PORT=8082
USER_DB_URL=jdbc:oracle:thin:@localhost:1521/FREEPDB1
USER_DB_USERNAME=USER_SCHEMA
USER_DB_PASSWORD=your_user_db_password

# ------------------------------------------------------------------------------
# 5. Account Service Configuration & Database Secrets
# ------------------------------------------------------------------------------
ACCOUNT_SERVER_PORT=8083
ACCOUNT_DB_URL=jdbc:oracle:thin:@localhost:1521/FREEPDB1
ACCOUNT_DB_USERNAME=ACCOUNT_SCHEMA
ACCOUNT_DB_PASSWORD=your_account_db_password

# ------------------------------------------------------------------------------
# 6. Transaction Service Configuration & Database Secrets
# ------------------------------------------------------------------------------
TRANSACTION_SERVER_PORT=8084
TRANSACTION_DB_URL=jdbc:oracle:thin:@localhost:1521/FREEPDB1
TRANSACTION_DB_USERNAME=TRANSACTION_SCHEMA
TRANSACTION_DB_PASSWORD=your_transaction_db_password

# ------------------------------------------------------------------------------
# 7. Notification Service Configuration & Database Secrets
# ------------------------------------------------------------------------------
NOTIFICATION_SERVER_PORT=8085
NOTIFICATION_DB_URL=jdbc:oracle:thin:@localhost:1521/FREEPDB1
NOTIFICATION_DB_USERNAME=NOTIFICATION_SCHEMA
NOTIFICATION_DB_PASSWORD=your_notification_db_password
MAIL_USERNAME=your_mail_username
MAIL_PASSWORD=your_mail_app_password

# ------------------------------------------------------------------------------
# 8. Infrastructure Services
# ------------------------------------------------------------------------------
EUREKA_URI=http://localhost:8761/eureka/
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
